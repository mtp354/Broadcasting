    "# Testing functions in library\n",
    "thetas = [np.pi/6]  # The sender phase angles\n",
    "N_receivers = 2\n",
    "circuit = db.generate_qiskit_circuit(1, N_receivers, thetas)\n",
    "\n",
    "circuit, reg_name, phi = db.add_fidelity(circuit, N=N_receivers, thetas=thetas)\n",
    "\n",
    "circuit.draw(\"mpl\")\n"
   ]
